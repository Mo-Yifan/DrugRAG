# ================================
# 🌐 应用通用设置
# ================================
DEBUG=false
PROJECT_NAME="DrugBank Clinical RAG"

# ================================
# 📁 路径配置（相对路径基于项目根目录）
# ================================
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# ================================
# 🔍 Embedding 模型（用于向量化问题与文档）
# ================================
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cuda          # 可选: "cuda", "mps" (Mac), "cpu"
EMBEDDING_BATCH_SIZE=32

# ================================
# 🗃️ 向量数据库 (Chroma)
# ================================
CHROMA_COLLECTION=drugbank_rag
CHROMA_PERSIST_DIR=./artifacts/vectors/chroma

# ================================
# 🔝 重排序器 (Reranker) — 提升检索精度
# ================================
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda           # 同上
RERANKER_TOP_K=5               # 最终返回给 LLM 的 top 文档数

# ================================
# 🧠 LLM 配置（二选一）
# ================================

# --- 选项 1: OpenAI API ---
#LLM_TYPE=openai
#OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#OPENAI_MODEL=gpt-4o-mini       # 或 gpt-4o, gpt-4-turbo
#OPENAI_MAX_TOKENS=1024
#OPENAI_TEMPERATURE=0.0         # 0.0 = 确定性输出（推荐用于事实问答）

# --- 选项 2: 本地开源模型（取消注释以下行并注释 OpenAI 部分）---
LLM_TYPE=local
LOCAL_LLM_MODEL=D:/DoubleFloorModel/models/qwen2.5-3b-med-merged   # 或 mistralai/Mistral-7B-Instruct-v0.3
LLM_DEVICE=cuda
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1

# ================================
# 🧩 RAG 超参数
# ================================
RETRIEVER_TOP_K=10             # 初检召回数量（输入 reranker）
FINAL_ANSWER_TOP_K=3           # 最终答案中最多引用的来源数

# ================================
# ⚠️ 安全提示
# ================================
# - 切勿将此文件提交到 Git！请确保 .gitignore 包含：
#     .env
#     artifacts/
#     data/drugbank.xml
# - 生产部署时，通过环境变量注入敏感信息（如 OPENAI_API_KEY）